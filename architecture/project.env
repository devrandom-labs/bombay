# shellcheck shell=bash
# The values of this project for the tools of the harness. A tool reads this file and
# nothing else that names the project. Each value can be set in the environment.
# GitHub repository of the issues and pull requests.
HARNESS_REPO=${HARNESS_REPO:-devrandom-labs/bombay}
# Organization that owns the project board.
HARNESS_PROJECT_OWNER=${HARNESS_PROJECT_OWNER:-devrandom-labs}
# Number of the project board in that organization.
HARNESS_PROJECT_NUMBER=${HARNESS_PROJECT_NUMBER:-6}
# Login that new cards are assigned to.
HARNESS_ASSIGNEE=${HARNESS_ASSIGNEE:-joeldsouzax}
# Name of the main branch.
HARNESS_MAIN=${HARNESS_MAIN:-main}
# Per-project cache folder name under ~/.cache/<name>.
HARNESS_CACHE_NAME=${HARNESS_CACHE_NAME:-bombay}
# Workflows that the harness owner may start by hand, separated by spaces.
HARNESS_OWNER_WORKFLOWS=${HARNESS_OWNER_WORKFLOWS:-checks.yml}
# Names of the lanes, separated by spaces. Each lane has the worktree <worktrees>/<lane>.
HARNESS_LANES=${HARNESS_LANES:-runtime domain adapters nix}
# Command that starts the lead of a lane, when STEP_LEAD is not set in the environment.
HARNESS_LEAD=${HARNESS_LEAD:-codex exec -m gpt-6.2-sol -s danger-full-access}
# Program that starts the harness owner session and its check loop (agy or claude).
HARNESS_OWNER_CLI=${HARNESS_OWNER_CLI:-agy}
# Model for the Antigravity harness owner when HARNESS_OWNER_CLI is agy.
HARNESS_OWNER_MODEL=${HARNESS_OWNER_MODEL:-gemini-4-carbon-high}
